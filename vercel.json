{
  "rewrites": [{"source":"/inquiry","destination":"/inquiry.html"}],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/audit/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/signin-log.html","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/thank-you.html","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
